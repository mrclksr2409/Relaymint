msgid "Field"
msgstr "Feld"

#: includes/admin/views/settings-routing.php:30
msgid "Operator"
msgstr "Operator"

#: includes/admin/views/settings-routing.php:35
msgid "Value"
msgstr "Wert"

#: includes/admin/views/settings-routing.php:36
msgid "Remove condition"
msgstr "Bedingung entfernen"

#: includes/admin/views/settings-routing.php:56
msgid "+ And"
msgstr "+ Und"

#: includes/admin/views/settings-routing.php:57
msgid "or"
msgstr "oder"

#: includes/admin/views/settings-routing.php:71
msgid "Enabled"
msgstr "Aktiv"

#: includes/admin/views/connection-fields.php:35
#: includes/admin/views/settings-routing.php:73
msgid "Send via"
msgstr "Senden über"

#: includes/admin/views/settings-routing.php:81
msgid "Move up"
msgstr "Nach oben"

#: includes/admin/views/settings-routing.php:82
msgid "Move down"
msgstr "Nach unten"

#: includes/admin/views/settings-routing.php:83
msgid "Remove route"
msgstr "Route entfernen"

#: includes/admin/views/settings-routing.php:87
msgid "if the following conditions match:"
msgstr "wenn die folgenden Bedingungen zutreffen:"

#: includes/admin/views/settings-routing.php:95
msgid "+ Add condition group (or)"
msgstr "+ Bedingungsgruppe hinzufügen (oder)"

#: includes/admin/views/settings-routing.php:107
msgid "Send emails through different connections based on conditions. Routes are checked from top to bottom; the first matching route wins. Emails that match no route use the primary connection."
msgstr "E-Mails abhängig von Bedingungen über verschiedene Verbindungen senden. Routen werden von oben nach unten geprüft, die erste passende Route gewinnt. E-Mails ohne passende Route nutzen die primäre Verbindung."

#: includes/admin/views/settings-routing.php:112
msgid "Smart Routing needs at least one additional connection."
msgstr "Smart Routing benötigt mindestens eine zusätzliche Verbindung."

#: includes/admin/views/settings-routing.php:113
